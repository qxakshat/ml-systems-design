<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="draw.io" version="22.0.0">
  <diagram name="Bing Search Diversification" id="bing-search-diversification">
    <mxGraphModel dx="2074" dy="1156" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Bing Search (Result Diversification)&lt;/b&gt;&lt;br&gt;L7 FAANG System Design" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1100" y="20" width="480" height="50" as="geometry" />
        </mxCell>

        <!-- Scale -->
        <mxCell id="scale-box" value="&lt;b&gt;Scale &amp; Requirements&lt;/b&gt;&lt;br&gt;- 1B+ searches/day (Bing + Edge + Copilot)&lt;br&gt;- 100B+ web pages indexed&lt;br&gt;- Latency: &lt;200ms end-to-end&lt;br&gt;- Diversification: cover multiple intents&lt;br&gt;- Freshness: breaking news &lt;minutes&lt;br&gt;- Multi-vertical: web, news, images, video&lt;br&gt;- Ambiguous queries: hedge across intents&lt;br&gt;- Authority vs freshness balance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="350" height="180" as="geometry" />
        </mxCell>

        <!-- Tech Stack -->
        <mxCell id="tech-stack" value="&lt;b&gt;Tech Stack&lt;/b&gt;&lt;br&gt;- Index: custom distributed inverted index&lt;br&gt;- Ranking: ONNX Runtime + custom DNN&lt;br&gt;- Training: PyTorch + DeepSpeed (ZeRO-3)&lt;br&gt;- Embeddings: FAISS + DiskANN (MS Research)&lt;br&gt;- Crawler: custom (Bingbot), 10B pages/mo&lt;br&gt;- Feature Store: Cosmos DB + Redis&lt;br&gt;- Stream: Azure Event Hubs&lt;br&gt;- LLM: Bing Chat (GPT-4 integration)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="350" height="180" as="geometry" />
        </mxCell>

        <!-- Data -->
        <mxCell id="data-title" value="&lt;b&gt;DATA &amp; QUERY UNDERSTANDING&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="query-understanding" value="&lt;b&gt;Query Understanding Pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Intent classification:&lt;br&gt;  - Navigational (specific site)&lt;br&gt;  - Informational (learn about)&lt;br&gt;  - Transactional (buy/do)&lt;br&gt;  - Ambiguous (multi-intent)&lt;br&gt;- Entity linking (knowledge graph)&lt;br&gt;- Query reformulation &amp; expansion&lt;br&gt;- Spell correction (neural LM)&lt;br&gt;- Sub-intent mining (query facets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="120" width="260" height="190" as="geometry" />
        </mxCell>

        <mxCell id="doc-understanding" value="&lt;b&gt;Document Understanding&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Content extraction (HTML parsing)&lt;br&gt;- Topic classification (1000+ topics)&lt;br&gt;- Entity extraction (NER)&lt;br&gt;- Quality scoring (E-E-A-T signals)&lt;br&gt;- Freshness detection (publish date)&lt;br&gt;- Language &amp; region classification&lt;br&gt;- Spam/low-quality filtering&lt;br&gt;- BERT passage embeddings (768-d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="240" height="175" as="geometry" />
        </mxCell>

        <mxCell id="intent-distribution" value="&lt;b&gt;Intent Distribution Estimation&lt;/b&gt;&lt;br&gt;&lt;br&gt;- P(intent | query) for each sub-intent&lt;br&gt;- Example: &quot;python&quot; →&lt;br&gt;  - Programming language: 0.7&lt;br&gt;  - Snake: 0.15&lt;br&gt;  - Monty Python: 0.15&lt;br&gt;- Estimated from click logs (historical)&lt;br&gt;- Updated with real-time click patterns&lt;br&gt;- Used for proportional diversification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="330" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- Model Architecture -->
        <mxCell id="model-title" value="&lt;b&gt;MODEL ARCHITECTURE (Ranking + Diversification)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="80" width="400" height="30" as="geometry" />
        </mxCell>

        <mxCell id="l1-ranking" value="&lt;b&gt;L1 Ranking (Retrieval)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- BM25 + learned sparse (SPLADE)&lt;br&gt;- Dense retrieval: bi-encoder (DPR)&lt;br&gt;- Hybrid fusion: RRF (Reciprocal Rank Fusion)&lt;br&gt;- Retrieve 10,000 candidates per query&lt;br&gt;- Fast scoring: &lt;5ms for 10K docs&lt;br&gt;- Pre-computed document embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="310" height="130" as="geometry" />
        </mxCell>

        <mxCell id="l2-ranking" value="&lt;b&gt;L2 Ranking (Cross-Encoder Reranking)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Architecture: DeBERTa-v3-large (300M)&lt;br&gt;- Input: [query] [SEP] [passage]&lt;br&gt;- Fine-tuned on MS MARCO + Bing clicks&lt;br&gt;- Score top-1000 candidates&lt;br&gt;- Distilled to smaller model for serving&lt;br&gt;- Features: relevance + quality + authority&lt;br&gt;- Multi-field: title, snippet, URL, anchor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="260" width="310" height="155" as="geometry" />
        </mxCell>

        <mxCell id="diversification" value="&lt;b&gt;Diversification Algorithm (xQuAD / PM-2)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- xQuAD (Explicit Query Aspect Diversification):&lt;br&gt;  - Score = (1-λ)×Rel(d,q) + λ×Div(d,q,S)&lt;br&gt;  - Div = Σ P(intent_i|q) × P(d|intent_i) × novelty&lt;br&gt;  - λ = 0.5 (balance relevance &amp; diversity)&lt;br&gt;&lt;br&gt;- PM-2 (Proportional representation):&lt;br&gt;  - Allocate slots proportional to P(intent)&lt;br&gt;  - Greedy selection: fill most underserved intent&lt;br&gt;&lt;br&gt;- MMR (Maximal Marginal Relevance):&lt;br&gt;  - Penalize similarity to already-selected docs&lt;br&gt;  - sim(d, S) computed via embedding cosine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="425" width="340" height="220" as="geometry" />
        </mxCell>

        <mxCell id="neural-div" value="&lt;b&gt;Neural Diversification (Learned)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- SetTransformer: models doc interactions&lt;br&gt;- Input: query + candidate set (top-100)&lt;br&gt;- Self-attention across documents&lt;br&gt;- Output: reordered list maximizing NDCG-IA&lt;br&gt;- Trained with listwise loss (approxNDCG)&lt;br&gt;- Diversity label: subtopic recall@K" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="655" width="340" height="130" as="geometry" />
        </mxCell>

        <!-- Training -->
        <mxCell id="training-title" value="&lt;b&gt;TRAINING DETAILS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="80" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="training-config" value="&lt;b&gt;Ranking Model Training&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Pre-training: MS MARCO (500K queries)&lt;br&gt;- Fine-tuning: Bing click logs (100M+)&lt;br&gt;- Labels: click dwell time → relevance&lt;br&gt;  - SAT click (&gt;30s): label=3&lt;br&gt;  - Normal click: label=2&lt;br&gt;  - Skip/short: label=0&lt;br&gt;- Loss: LambdaRank (pairwise NDCG)&lt;br&gt;- Optimizer: AdamW, lr=2e-5&lt;br&gt;- Batch: 256, gradient accumulation=4&lt;br&gt;- DeepSpeed ZeRO-3, 64 GPUs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="120" width="280" height="210" as="geometry" />
        </mxCell>

        <mxCell id="div-training" value="&lt;b&gt;Diversification Training&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Intent labels: editorial (TREC Web Track)&lt;br&gt;- Subtopic annotations: 3-10 per query&lt;br&gt;- Reward: α-NDCG, ERR-IA, S-recall&lt;br&gt;- Reinforcement learning (REINFORCE)&lt;br&gt;- State: current selected set&lt;br&gt;- Action: select next document&lt;br&gt;- Offline policy evaluation (IPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="340" width="280" height="150" as="geometry" />
        </mxCell>

        <!-- Serving -->
        <mxCell id="serving-title" value="&lt;b&gt;SERVING PIPELINE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="510" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="serving" value="&lt;b&gt;Multi-Vertical Blending&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Verticals: Web, News, Images, Video, Maps&lt;br&gt;- Each vertical independently retrieves+ranks&lt;br&gt;- Blending model: when to insert each vertical&lt;br&gt;- News: triggered by trending/breaking queries&lt;br&gt;- Images: triggered by visual intent&lt;br&gt;- Knowledge panel: entity queries&lt;br&gt;- Answer box: factoid queries&lt;br&gt;- Bing Chat: complex/conversational queries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="550" width="280" height="170" as="geometry" />
        </mxCell>

        <mxCell id="freshness" value="&lt;b&gt;Freshness &amp; Real-Time Updates&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Streaming index for breaking news&lt;br&gt;- QDF (Query Deserves Freshness) detector&lt;br&gt;- Breaking query detection (spike in volume)&lt;br&gt;- Time-decay ranking boost&lt;br&gt;- Real-time re-ranking on trending events&lt;br&gt;- Source authority for news (trust signals)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="740" y="550" width="230" height="130" as="geometry" />
        </mxCell>

        <!-- Metrics -->
        <mxCell id="metrics-title" value="&lt;b&gt;METRICS &amp; TRADEOFFS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="750" width="350" height="30" as="geometry" />
        </mxCell>

        <mxCell id="metrics" value="&lt;b&gt;Evaluation Metrics&lt;/b&gt;&lt;br&gt;&lt;br&gt;- NDCG (standard relevance)&lt;br&gt;- α-NDCG (intent-aware diversity)&lt;br&gt;- ERR-IA (Expected Reciprocal Rank)&lt;br&gt;- Subtopic Recall@K (coverage)&lt;br&gt;- Satisfied clicks (dwell &gt; 30s)&lt;br&gt;- Abandonment rate&lt;br&gt;- Session success rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="440" y="790" width="250" height="155" as="geometry" />
        </mxCell>

        <mxCell id="tradeoffs" value="&lt;b&gt;Key Tradeoffs&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Relevance vs Diversity (λ tuning)&lt;br&gt;- Majority intent vs Minority coverage&lt;br&gt;- Freshness vs Authority/quality&lt;br&gt;- Computational cost of diversification&lt;br&gt;- Personalization vs Diversity (conflict)&lt;br&gt;- Coverage vs Redundancy elimination&lt;br&gt;- Greedy selection vs Optimal (NP-hard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="710" y="790" width="260" height="155" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="query-understanding" target="l1-ranking" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="l1-ranking" target="l2-ranking" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="l2-ranking" target="diversification" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="intent-distribution" target="diversification" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="diversification" target="serving" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>