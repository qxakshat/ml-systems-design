<mxfile host="app.diagrams.net" modified="2024-01-01T00:00:00.000Z" agent="draw.io" version="22.0.0">
  <diagram name="Medical Diagnostics CV System" id="medical-diag-cv">
    <mxGraphModel dx="2074" dy="1156" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Medical Diagnostics System (Computer Vision)&lt;/b&gt;&lt;br&gt;L7 FAANG System Design" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1100" y="20" width="500" height="50" as="geometry" />
        </mxCell>

        <!-- Scale Box -->
        <mxCell id="scale-box" value="&lt;b&gt;Scale &amp; Requirements&lt;/b&gt;&lt;br&gt;- 10M+ scans/day across hospitals&lt;br&gt;- Latency: &lt;2s per inference&lt;br&gt;- 99.99% availability (life-critical)&lt;br&gt;- Multi-modal: X-ray, CT, MRI, Pathology&lt;br&gt;- Regulatory: FDA/CE compliance required&lt;br&gt;- Sensitivity &gt; 95%, Specificity &gt; 90%&lt;br&gt;- HIPAA compliant data handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="350" height="170" as="geometry" />
        </mxCell>

        <!-- Tech Stack Box -->
        <mxCell id="tech-stack" value="&lt;b&gt;Tech Stack&lt;/b&gt;&lt;br&gt;- Training: PyTorch, MONAI, TorchXLA&lt;br&gt;- Serving: TensorRT, Triton Inference Server&lt;br&gt;- Orchestration: Kubernetes (GKE/EKS)&lt;br&gt;- Storage: GCS/S3 + DICOM PACS&lt;br&gt;- Feature Store: Feast&lt;br&gt;- MLOps: MLflow, Weights &amp; Biases&lt;br&gt;- Data Pipeline: Apache Beam / Dataflow&lt;br&gt;- Monitoring: Prometheus + Grafana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="350" height="180" as="geometry" />
        </mxCell>

        <!-- Data Ingestion Layer -->
        <mxCell id="data-layer-title" value="&lt;b&gt;DATA INGESTION &amp; PREPROCESSING&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="dicom-ingest" value="&lt;b&gt;DICOM Ingestion&lt;/b&gt;&lt;br&gt;- HL7 FHIR gateway&lt;br&gt;- PACS integration (Orthanc)&lt;br&gt;- De-identification pipeline&lt;br&gt;- PHI removal (pydicom)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="preprocessing" value="&lt;b&gt;Preprocessing&lt;/b&gt;&lt;br&gt;- Window/Level normalization&lt;br&gt;- Resize to 512x512 / 224x224&lt;br&gt;- CLAHE contrast enhancement&lt;br&gt;- Hounsfield unit calibration&lt;br&gt;- Multi-slice 3D volume assembly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="220" height="120" as="geometry" />
        </mxCell>

        <mxCell id="augmentation" value="&lt;b&gt;Data Augmentation&lt;/b&gt;&lt;br&gt;- Random rotation ±15°&lt;br&gt;- Elastic deformation&lt;br&gt;- Cutout / CutMix&lt;br&gt;- Color jitter (intensity)&lt;br&gt;- Mixup (α=0.2)&lt;br&gt;- Test-Time Augmentation (TTA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="500" y="240" width="200" height="130" as="geometry" />
        </mxCell>

        <mxCell id="data-stats" value="&lt;b&gt;Data Characteristics&lt;/b&gt;&lt;br&gt;- Training: 2M labeled images&lt;br&gt;- Class imbalance: 50:1 (healthy:diseased)&lt;br&gt;- Multi-label: 14 pathology classes&lt;br&gt;- Expert annotations (3 radiologists)&lt;br&gt;- Active learning for edge cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="720" y="250" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Model Architecture -->
        <mxCell id="model-title" value="&lt;b&gt;MODEL ARCHITECTURE (DEEP LEARNING)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="80" width="350" height="30" as="geometry" />
        </mxCell>

        <mxCell id="backbone" value="&lt;b&gt;Backbone: EfficientNet-V2-L / ConvNeXt-XL&lt;/b&gt;&lt;br&gt;&lt;br&gt;- ImageNet-21K pretrained&lt;br&gt;- Progressive resizing: 224→384→512&lt;br&gt;- Squeeze-Excitation blocks&lt;br&gt;- Compound scaling (depth/width/res)&lt;br&gt;- FPN neck for multi-scale features&lt;br&gt;- Params: ~480M (EfficientNet-V2-L)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="350" height="150" as="geometry" />
        </mxCell>

        <mxCell id="detection-head" value="&lt;b&gt;Detection Head (Lesion Localization)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- DETR / Faster R-CNN w/ FPN&lt;br&gt;- Anchor-free: CenterNet variant&lt;br&gt;- NMS threshold: 0.5&lt;br&gt;- Multi-scale detection: P3-P7&lt;br&gt;- Output: bbox + class + confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="350" height="130" as="geometry" />
        </mxCell>

        <mxCell id="segmentation-head" value="&lt;b&gt;Segmentation Head (Pixel-level)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- U-Net++ / nnU-Net architecture&lt;br&gt;- Deep supervision at each decoder level&lt;br&gt;- Attention gates for skip connections&lt;br&gt;- 3D variant for volumetric data (CT/MRI)&lt;br&gt;- Output: per-pixel class probabilities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="420" width="350" height="130" as="geometry" />
        </mxCell>

        <mxCell id="classification-head" value="&lt;b&gt;Classification Head (Global Diagnosis)&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Global Average Pooling → FC layers&lt;br&gt;- Multi-label sigmoid output (14 classes)&lt;br&gt;- Ordinal regression for severity grading&lt;br&gt;- Temperature scaling for calibration&lt;br&gt;- MC Dropout for uncertainty estimation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="350" height="130" as="geometry" />
        </mxCell>

        <!-- Training Details -->
        <mxCell id="training-title" value="&lt;b&gt;TRAINING PIPELINE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1420" y="80" width="250" height="30" as="geometry" />
        </mxCell>

        <mxCell id="training-details" value="&lt;b&gt;Training Configuration&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Optimizer: AdamW (lr=1e-4, wd=0.05)&lt;br&gt;- Scheduler: Cosine annealing w/ warmup&lt;br&gt;- Batch: 64 (8 GPUs × 8 per GPU)&lt;br&gt;- Mixed precision (FP16/BF16)&lt;br&gt;- Gradient accumulation: 4 steps&lt;br&gt;- EMA (decay=0.9999)&lt;br&gt;- Training time: ~72h on 8×A100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="120" width="280" height="170" as="geometry" />
        </mxCell>

        <mxCell id="loss-functions" value="&lt;b&gt;Loss Functions&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Classification: Focal Loss (γ=2, α=0.25)&lt;br&gt;- Segmentation: Dice + BCE (0.5 + 0.5)&lt;br&gt;- Detection: GIoU + L1 + Focal&lt;br&gt;- Class imbalance: Effective number weighting&lt;br&gt;- Label smoothing: ε=0.1&lt;br&gt;- Knowledge distillation (teacher→student)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="300" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="regularization" value="&lt;b&gt;Regularization&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Dropout: 0.3 (final FC layers)&lt;br&gt;- Stochastic depth: 0.2&lt;br&gt;- Weight decay: 0.05&lt;br&gt;- Early stopping (patience=10)&lt;br&gt;- K-fold cross-validation (K=5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="450" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- Serving & Inference -->
        <mxCell id="serving-title" value="&lt;b&gt;SERVING &amp; INFERENCE PIPELINE&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="420" width="350" height="30" as="geometry" />
        </mxCell>

        <mxCell id="serving-pipeline" value="&lt;b&gt;Inference Optimization&lt;/b&gt;&lt;br&gt;&lt;br&gt;- TensorRT FP16 optimization&lt;br&gt;- Dynamic batching (Triton)&lt;br&gt;- Model ensemble (5-fold average)&lt;br&gt;- ONNX export → TensorRT engine&lt;br&gt;- GPU: NVIDIA T4/A10G (inference)&lt;br&gt;- Latency: ~200ms per image&lt;br&gt;- Throughput: 500 img/sec/GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="500" y="460" width="250" height="160" as="geometry" />
        </mxCell>

        <mxCell id="post-processing" value="&lt;b&gt;Post-Processing&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Confidence thresholding (0.5)&lt;br&gt;- Non-max suppression&lt;br&gt;- Connected component analysis&lt;br&gt;- Uncertainty quantification&lt;br&gt;- Grad-CAM++ heatmaps&lt;br&gt;- SHAP explanations&lt;br&gt;- Report generation (NLP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="770" y="460" width="200" height="160" as="geometry" />
        </mxCell>

        <!-- Metrics -->
        <mxCell id="metrics-title" value="&lt;b&gt;METRICS &amp; TRADEOFFS&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="650" width="350" height="30" as="geometry" />
        </mxCell>

        <mxCell id="metrics" value="&lt;b&gt;Evaluation Metrics&lt;/b&gt;&lt;br&gt;&lt;br&gt;- AUC-ROC (per class &amp; macro)&lt;br&gt;- Sensitivity @ 95% specificity&lt;br&gt;- FROC (Free-response ROC)&lt;br&gt;- Dice coefficient (segmentation)&lt;br&gt;- mAP@[0.5:0.95] (detection)&lt;br&gt;- ECE (Expected Calibration Error)&lt;br&gt;- Cohen's Kappa (inter-rater agreement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="500" y="690" width="250" height="160" as="geometry" />
        </mxCell>

        <mxCell id="tradeoffs" value="&lt;b&gt;Key Tradeoffs&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Sensitivity vs Specificity (clinical priority)&lt;br&gt;- Model size vs Latency (TensorRT helps)&lt;br&gt;- Ensemble accuracy vs Single model speed&lt;br&gt;- Explainability vs Performance&lt;br&gt;- Generalization vs Specialization&lt;br&gt;- Data privacy vs Model improvement&lt;br&gt;- Over-diagnosis risk vs Miss rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="770" y="690" width="250" height="160" as="geometry" />
        </mxCell>

        <!-- Monitoring & Safety -->
        <mxCell id="monitoring-title" value="&lt;b&gt;MONITORING &amp; SAFETY&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fillColor=#f8cecc;strokeColor=#b85450;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="720" width="300" height="30" as="geometry" />
        </mxCell>

        <mxCell id="monitoring" value="&lt;b&gt;Production Monitoring&lt;/b&gt;&lt;br&gt;&lt;br&gt;- Data drift detection (KS-test on pixel dist)&lt;br&gt;- Prediction confidence distribution shift&lt;br&gt;- Hardware-specific calibration checks&lt;br&gt;- Feedback loop: radiologist corrections&lt;br&gt;- A/B testing new model versions&lt;br&gt;- Shadow deployment before promotion&lt;br&gt;- Federated learning across hospitals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="1050" y="760" width="300" height="160" as="geometry" />
        </mxCell>

        <!-- Arrows connecting components -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="dicom-ingest" target="preprocessing" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="preprocessing" target="augmentation" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="augmentation" target="backbone" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="backbone" target="detection-head" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="backbone" target="segmentation-head" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="backbone" target="classification-head" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="classification-head" target="serving-pipeline" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" source="serving-pipeline" target="post-processing" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>